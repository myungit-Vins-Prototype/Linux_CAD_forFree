# Dipendenze conservative del calcolo: include locali transitivi e relativa
# implementazione .cpp. Si esplorano anche include condizionali; nessun filtro
# basato sul nome "UI" puo' escludere una dipendenza effettiva del modello.
function(forgecad_collect_geometry_sources output root)
    set(pending ${ARGN})
    set(collected)
    while(pending)
        list(POP_FRONT pending source)
        get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${root}")
        if(source IN_LIST collected)
            continue()
        endif()
        if(NOT EXISTS "${source}")
            message(FATAL_ERROR "Dipendenza geometrica assente: ${source}")
        endif()
        list(APPEND collected "${source}")
        get_filename_component(directory "${source}" DIRECTORY)
        get_filename_component(extension "${source}" EXT)
        if(extension STREQUAL ".h" OR extension STREQUAL ".hpp")
            get_filename_component(stem "${source}" NAME_WE)
            if(EXISTS "${directory}/${stem}.cpp")
                list(APPEND pending "${directory}/${stem}.cpp")
            endif()
        endif()
        file(STRINGS "${source}" includes REGEX "^[ \t]*#[ \t]*include[ \t]*[\"<]")
        foreach(line IN LISTS includes)
            string(REGEX MATCH "#[ \t]*include[ \t]*[\"<]([^\">]+)[\">]" matched "${line}")
            if(NOT matched)
                continue()
            endif()
            set(include "${CMAKE_MATCH_1}")
            foreach(base IN ITEMS "${directory}" "${root}" "${root}/kernel")
                if(EXISTS "${base}/${include}")
                    list(APPEND pending "${base}/${include}")
                    break()
                endif()
            endforeach()
        endforeach()
    endwhile()
    list(SORT collected)
    set(${output} "${collected}" PARENT_SCOPE)
endfunction()
