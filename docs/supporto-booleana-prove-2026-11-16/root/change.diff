+                        break;
+                    }
+                    chain[n].boundarySource.intersection = arc.curve;
+                    chain[n].boundarySource.intersectionRange = {ta, tb};
+                    ta = tb;
+                }
+                if (certified)
+                    candidates.push_back(std::move(chain));
+            }
+        }
+    if (candidates.size() != 1)
+        return false;
+    result = std::move(candidates.front());
