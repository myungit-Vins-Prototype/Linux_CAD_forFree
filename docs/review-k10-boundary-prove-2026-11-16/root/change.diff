+void extendBlendBoundary(Body &body, BlendModel &model, EdgeId id, const Interval &window, bool tangentSeams, std::vector<BlendBoundaryUse> &certificates) {
+    cancellationPoint();
+    const Edge &edge = body.edge(id);
+    if (!edge.curve || !edge.range.isFinite() || !(edge.range.lo < edge.range.hi)
+        || !window.isFinite() || !std::isfinite(window.length())
+        || window.lo > edge.range.lo || window.hi < edge.range.hi
+        || !std::isfinite(edge.tolerance) || edge.tolerance < 0.0
+        || !edge.forward.valid() || !edge.backward.valid())
+        throw std::domain_error("blendEdges: dati della frontiera da prolungare non validi");
+    const auto validTolerance = [](double value) { return std::isfinite(value) && value >= 0.0; };
+    if (!validTolerance(body.vertex(body.edgeStart(id)).tolerance)
+        || !validTolerance(body.vertex(body.edgeEnd(id)).tolerance)
+        || !validTolerance(body.fin(edge.forward).pcurveTolerance)
+        || !validTolerance(body.fin(edge.backward).pcurveTolerance))
+        throw std::domain_error("blendEdges: budget sorgente della frontiera non valido");
+    // Validate planned provenance before any commit to body or model.
+    (void)model.edges.at(std::size_t(model.edgeIndex.at(id.index)));
+    for (FinId fin : {edge.forward, edge.backward})
+        (void)model.faces.at(std::size_t(model.faceIndex.at(body.finFace(fin).index)));
+    const CurvePtr<3> original = edge.curve;
+    const CurvePtr<3> predictor = detail::blendSectionCurve(original, edge.range);
+    const FinId fins[2] = {edge.forward, edge.backward};
+    std::array<SurfacePtr, 2> supports;
+    std::array<CurvePtr<2>, 2> originalUV;
+    for (int side = 0; side < 2; ++side) {
+        const Face &face = body.face(body.finFace(fins[side]));
+        const auto pc = body.fin(fins[side]).pcurve;
+        if (!pc) throw std::domain_error("blendEdges: SP-curve mancante nel prolungamento del bordo");
+        supports[side] = face.surface;
+        originalUV[side] = pc;
+        if (face.surface->type() != SurfaceType::BSpline) continue;
+        const Interval oldU = face.surface->uDomain(), oldV = face.surface->vDomain();
+        Interval u = oldU, v = oldV;
+        for (int sample = 0; sample <= 32; ++sample) {
+            const double t = window.lo + window.length() * sample / 32.0;
+            const double end = std::clamp(t, edge.range.lo, edge.range.hi);
+            const Vec2 uv = pc->point(end) + (t - end) * pc->derivative(end);
+            u.lo = std::min(u.lo, uv.x()); u.hi = std::max(u.hi, uv.x());
+            v.lo = std::min(v.lo, uv.y()); v.hi = std::max(v.hi, uv.y());
+        }
+        // Existing polynomial carrier extension, with refinement margin.
+        // The continuous certificate below covers the actual edge/fin uses;
+        // it is not a runtime preservation proof on the whole old UV rectangle.
+        if (u.lo < oldU.lo) u.lo -= 0.05 * oldU.length();
+        if (u.hi > oldU.hi) u.hi += 0.05 * oldU.length();
+        if (v.lo < oldV.lo) v.lo -= 0.05 * oldV.length();
+        if (v.hi > oldV.hi) v.hi += 0.05 * oldV.length();
+        if (u.lo != oldU.lo || u.hi != oldU.hi || v.lo != oldV.lo || v.hi != oldV.hi)
+            supports[side] = std::make_shared<BSplineSurface>(
+                extendBSplineSurface(static_cast<const BSplineSurface &>(*face.surface), u, v));
+    }
+    // This physical cap is fixed before constructing any extension. The
+    // recognized branch never increases the source edge tolerance.
+    const double budget = std::max(2 * scaledAccuracy(1e-9), edge.tolerance);
+    const BlendBoundaryGuide certified = tangentSeams ? blendBoundaryIsoGuide(original, originalUV, supports,
+        edge.range, window, scaledAccuracy(1e-9), budget) : BlendBoundaryGuide{};
+    // Unsupported compositions retain the historical sampled branch; a
+    // failed recognized proof has already thrown and cannot arrive here.
+    const CurvePtr<3> isoGuide = certified.curve ? certified.curve
+        : tangentSeams ? sampledBoundaryIsoGuide(body, id, supports) : CurvePtr<3>();
+    double extensionDeviation = 0.0;
+    const auto extension = [&](const Interval &range, bool head) -> CurvePtr<3> {
+        if (certified.curve) return certified.curve;
+        if (isoGuide) {
+            double worst = 0.0;
+            const auto breaks = isoGuide->breakpoints(range);
+            for (std::size_t k = 1; k < breaks.size(); ++k)
+                for (double fraction : {0.0, 0.25, 0.5, 0.75, 1.0}) {
+                    const Vec3 p = isoGuide->point(breaks[k - 1] + fraction * (breaks[k] - breaks[k - 1]));
+                    for (int side = 0; side < 2; ++side) worst = std::max(worst, projectPoint(*supports[side], p).distance);
+                }
+            if (worst > std::max(2 * scaledAccuracy(1e-9), edge.tolerance))
+                throw std::domain_error("blendEdges: il prolungamento della cucitura tangente supera il supporto entro tolleranza");
+            extensionDeviation = std::max(extensionDeviation, worst);
+            return isoGuide;
+        }
+        const double endpoint = head ? edge.range.lo : edge.range.hi;
+        Vec3 jet[2];
+        if (head)
+            predictor->evaluate(endpoint, 1, jet);
+        else
+            predictor->evaluateLeft(endpoint, 1, jet);
+        const Vec3 origin = original->point(endpoint), tangent = normalized(jet[1]), velocity = jet[1];
+        Vec2 uv[2][2];
+        for (int side = 0; side < 2; ++side) {
+            const auto pc = body.fin(fins[side]).pcurve;
+            if (head)
+                pc->evaluate(endpoint, 1, uv[side]);
+            else
+                pc->evaluateLeft(endpoint, 1, uv[side]);
+        }
+        const auto continuation = [&](double t) {
+            const double dt = t - endpoint;
+            const Vec3 anchor = origin + dt * velocity;
+            const Vec2 pa = uv[0][0] + dt * uv[0][1], pb = uv[1][0] + dt * uv[1][1];
+            double x[4] = {pa.x(), pa.y(), pb.x(), pb.y()};
+            for (int iteration = 0; iteration < 30; ++iteration) {
+                cancellationPoint();
+                Vec3 a[4], b[4];
+                supports[0]->evaluate(x[0], x[1], 1, a);
+                supports[1]->evaluate(x[2], x[3], 1, b);
+                const Vec3 f = a[0] - b[0];
+                const double plane = dot(a[0] - anchor, tangent);
+                if (norm(f) < 1e-11 && std::fabs(plane) < 1e-11) return 0.5 * (a[0] + b[0]);
+                const Vec3 c[4] = {a[Surface::derivativeIndex(1, 0, 1)], a[Surface::derivativeIndex(0, 1, 1)],
+                                   -b[Surface::derivativeIndex(1, 0, 1)], -b[Surface::derivativeIndex(0, 1, 1)]};
+                double J[4][4] = {{c[0].x(), c[1].x(), c[2].x(), c[3].x()},
+                                  {c[0].y(), c[1].y(), c[2].y(), c[3].y()},
+                                  {c[0].z(), c[1].z(), c[2].z(), c[3].z()},
+                                  {dot(c[0], tangent), dot(c[1], tangent), 0.0, 0.0}};
+                double r[4] = {-f.x(), -f.y(), -f.z(), -plane};
+                if (!solveLinear<4>(J, r)) break;
+                for (int k = 0; k < 4; ++k) x[k] += r[k];
+            }
+            throw std::domain_error("blendEdges: prolungamento dell'intersezione non convergente");
+        };
+        return fitCurve(continuation, range, {}, scaledAccuracy(1e-9));
+    };
+    std::vector<CurvePtr<3>> curves;
+    std::vector<Interval> ranges;
+    if (window.lo < edge.range.lo) {
+        ranges.push_back({window.lo, edge.range.lo});
+        curves.push_back(extension(ranges.back(), true));
+    }
+    curves.push_back(original);
+    ranges.push_back(edge.range);
+    if (window.hi > edge.range.hi) {
+        ranges.push_back({edge.range.hi, window.hi});
+        curves.push_back(extension(ranges.back(), false));
+    }
+    const std::size_t originalPiece = window.lo < edge.range.lo ? 1 : 0;
+    const auto expanded = concatenateBoundary(curves, ranges, originalPiece);
+    requireCurveAgreement(expanded, original, edge.range, budget);
+    if (certified.curve)
+        for (int side = 0; side < 2; ++side)
+            requireBoundaryComposition(expanded, supports[side], certified.pcurves[side], window, budget);
+    // Prepare provenance storage before mutating either representation.
+    const int modelEdge = model.edgeIndex.at(id.index);
+    auto nextCertificates = certificates;
+    if (certified.curve) {
+        const double vertexBudget = std::max({linearResolution(), edge.tolerance,
+            body.vertex(body.edgeStart(id)).tolerance, body.vertex(body.edgeEnd(id)).tolerance});
+        for (int side = 0; side < 2; ++side) {
+            const int face = model.faceIndex.at(body.finFace(fins[side]).index);
+            nextCertificates.erase(std::remove_if(nextCertificates.begin(), nextCertificates.end(), [&](const BlendBoundaryUse &use) {
+                return use.edge == modelEdge && use.face == face;
+            }), nextCertificates.end());
+            nextCertificates.push_back({modelEdge, face, expanded, supports[side], certified.pcurves[side], window,
+                                       budget, edge.tolerance, vertexBudget});
+        }
+    }
+    // Commit only after construction and all proofs. Old SP-curves are reset
+    // for the sampled branch; recognized plans reinstall their actual UV maps
+    // after moveEnd has determined the final edge range.
+    body.edge(id).curve = expanded;
+    if (!certified.curve) // Legacy sampled compatibility, outside the certificate.
+        body.edge(id).tolerance = std::max(body.edge(id).tolerance, 2 * extensionDeviation);
+    model.edges[std::size_t(modelEdge)].curve = expanded;
+    model.edges[std::size_t(modelEdge)].tolerance = body.edge(id).tolerance;
+    for (int side = 0; side < 2; ++side) {
+        const FaceId face = body.finFace(fins[side]);
+        body.face(face).surface = supports[side];
+        model.faces[std::size_t(model.faceIndex.at(face.index))].surface = supports[side];
+    }
+    certificates.swap(nextCertificates);
+    for (auto &face : model.faces)
+        for (auto &loop : face.loops)
+            for (auto &fin : loop)
+                if (fin.edge == modelEdge) { fin.pcurve.reset(); fin.pcurveTolerance = 0.0; }
+}
