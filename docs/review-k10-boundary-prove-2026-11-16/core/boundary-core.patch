+void installBlendBoundaryCertificates(BlendModel &model, std::vector<BlendBoundaryUse> &plans) {
+    // Explicitly consumed edges no longer have an output fin obligation.
+    plans.erase(std::remove_if(plans.begin(), plans.end(), [&](const BlendBoundaryUse &plan) {
+        return !model.edgeAlive.at(std::size_t(plan.edge));
+    }), plans.end());
+    for (auto &plan : plans) {
+        cancellationPoint();
+        const auto &edge = model.edges.at(std::size_t(plan.edge));
+        auto &face = model.faces.at(std::size_t(plan.face));
+        if (edge.curve != plan.curve || edge.tolerance != plan.edgeTolerance
+            || !edge.range.isFinite() || !(edge.range.lo < edge.range.hi)
+            || edge.range.lo < plan.window.lo || edge.range.hi > plan.window.hi)
+            throw std::domain_error("blendEdges: parametro o budget della frontiera pianificata modificato");
+        // A later extension of this same source face may enlarge its carrier.
+        // Its face index is explicit provenance; prove the final carrier anew.
+        requireBoundaryComposition(edge.curve, face.surface, plan.pcurve, edge.range, plan.budget);
+        plan.surface = face.surface;
+        int uses = 0;
+        for (auto &loop : face.loops) for (auto &fin : loop) if (fin.edge == plan.edge) {
+            fin.pcurve = plan.pcurve;
+            fin.pcurveTolerance = plan.budget;
+            ++uses;
+        }
+        if (uses != 1)
+            throw std::domain_error("blendEdges: incidenza della frontiera pianificata persa o ambigua");
+    }
+}
+void requireEmittedBlendBoundaries(const Body &body, const std::vector<BlendBoundaryUse> &plans) {
+    for (const auto &plan : plans) {
+        cancellationPoint();
+        // BlendModel::build preserves face order (the same map used by its
+        // declared face history). Shared carrier pointers are therefore not
+        // ambiguous: this ordinal is construction provenance, never proximity.
+        const auto faces = body.faces();
+        if (plan.face < 0 || std::size_t(plan.face) >= faces.size())
+            throw std::domain_error("blendEdges: faccia della frontiera emessa non presente");
+        const FaceId face = faces[std::size_t(plan.face)];
+        if (body.face(face).surface != plan.surface)
+            throw std::domain_error("blendEdges: supporto della frontiera emessa modificato");
+        int uses = 0;
+        for (LoopId loop : body.face(face).loops)
+            for (FinId id : body.loopFins(loop)) {
+                const Fin &fin = body.fin(id);
+                const Edge &edge = body.edge(fin.edge);
+                if (edge.curve != plan.curve) continue;
+                if (fin.pcurve != plan.pcurve || fin.pcurveTolerance != plan.budget || edge.tolerance != plan.edgeTolerance
+                    || !edge.range.isFinite() || !(edge.range.lo < edge.range.hi)
+                    || edge.range.lo < plan.window.lo || edge.range.hi > plan.window.hi)
+                    throw std::domain_error("blendEdges: contratto della frontiera emessa modificato");
+                requireBoundaryComposition(edge.curve, body.face(face).surface, fin.pcurve, edge.range, plan.budget);
+                for (const auto &end : {std::make_pair(body.edgeStart(fin.edge), edge.range.lo),
+                                       std::make_pair(body.edgeEnd(fin.edge), edge.range.hi)}) {
+                    const Vertex &vertex = body.vertex(end.first);
+                    if (!isFinite(vertex.point) || !std::isfinite(vertex.tolerance) || vertex.tolerance < 0.0
+                        || vertex.tolerance > plan.vertexBudget
+                        || distance(vertex.point, edge.curve->point(end.second)) > plan.vertexBudget)
+                        throw std::domain_error("blendEdges: estremo della frontiera oltre il budget prefissato");
+                }
+                ++uses;
+            }
+        if (uses != 1)
+            throw std::domain_error("blendEdges: genealogia della frontiera emessa persa o ambigua");
+    }
+}
