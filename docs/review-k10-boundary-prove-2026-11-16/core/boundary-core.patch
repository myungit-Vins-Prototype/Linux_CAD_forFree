+BlendBoundaryGuide blendBoundaryIsoGuide(const CurvePtr<3> &original,
+    const std::array<CurvePtr<2>, 2> &pcurves, const std::array<SurfacePtr, 2> &supports,
+    const Interval &originalRange, const Interval &window, double fitTolerance, double budget) {
+    cancellationPoint();
+    if (!original || !originalRange.isFinite() || !(originalRange.lo < originalRange.hi) || !window.isFinite()
+        || window.lo > originalRange.lo || window.hi < originalRange.hi || !std::isfinite(window.length())
+        || !std::isfinite(fitTolerance) || !(fitTolerance > 0.0) || !std::isfinite(budget) || !(budget > 0.0))
+        throw std::domain_error("blendEdges: contratto della guida ISO non valido");
+    BlendBoundaryGuide guide;
+    for (int side = 0; side < 2; ++side) {
+        if (!pcurves[side]) throw std::domain_error("blendEdges: mappa originale della frontiera assente");
+        const Interval natural = pcurves[side]->domain();
+        if (originalRange.lo < natural.lo || originalRange.hi > natural.hi)
+            throw std::domain_error("blendEdges: parametro della frontiera fuori dalla mappa originale");
+        guide.pcurves[side] = extendedIsoMap(pcurves[side], window);
+        if (!guide.pcurves[side] || !supports[side] || supports[side]->type() != SurfaceType::BSpline) return {};
+    }
+    // Only after all families are recognized may any proof be attempted.
+    // Failures below are terminal for this branch.
+    const auto data = surfaceCompositionErrorBound(supports[0], guide.pcurves[0], window);
+    const auto other = surfaceCompositionErrorBound(supports[1], guide.pcurves[1], window);
+    if (!data.bound || !other.bound) return {};
+    for (int side = 0; side < 2; ++side)
+        requireBoundaryComposition(original, supports[side], guide.pcurves[side], originalRange, budget);
+    auto breaks = data.breaks;
+    breaks.insert(breaks.end(), other.breaks.begin(), other.breaks.end());
+    breaks.push_back(originalRange.lo); breaks.push_back(originalRange.hi);
+    guide.curve = fitCurveCertified([&](double t) {
+        const Vec2 uv = guide.pcurves[0]->point(t);
+        return supports[0]->point(uv.x(), uv.y());
+    }, window, breaks, std::min(fitTolerance, 0.25 * budget), data.bound);
+    for (int side = 0; side < 2; ++side)
+        requireBoundaryComposition(guide.curve, supports[side], guide.pcurves[side], window, budget);
+    guide.budget = budget;
+    return guide;
+}
