+namespace {
+// A cubic witness is auxiliary only: neither the original edge nor the
+// emitted curve is replaced. Both oracles own ORIGINAL coefficient snapshots.
+// Their outward sum bounds the actual curve/carrier residual by the triangle
+// inequality, independently of how the witness was sampled for construction.
+double outwardSum(double a, double b) {
+    if (!std::isfinite(a) || !std::isfinite(b) || a < 0.0 || b < 0.0)
+        return std::numeric_limits<double>::infinity();
+    return std::nextafter(a + b, std::numeric_limits<double>::infinity());
+}
+void requireCurveAgreement(const CurvePtr<3> &actual, const CurvePtr<3> &original,
+                           const Interval &range, double budget) {
+    const auto a = curvePositionErrorBound({{actual, range, range, false}});
+    const auto b = curvePositionErrorBound({{original, range, range, false}});
+    if (!a || !b) throw std::domain_error("blendEdges: preservazione del parametro non certificabile");
+    auto breaks = actual->breakpoints(range);
+    const auto extra = original->breakpoints(range);
+    breaks.insert(breaks.end(), extra.begin(), extra.end());
+    fitCurveCertified([&](double t) { return 0.5 * actual->point(t) + 0.5 * original->point(t); }, range, breaks,
+                      budget, [&](const Interval &span, const std::array<Vec3, 4> &poles) {
+                          return outwardSum(a(span, poles), b(span, poles));
+                      });
+}
+void requireBoundaryComposition(const CurvePtr<3> &curve, const SurfacePtr &surface, const CurvePtr<2> &pcurve,
+                                const Interval &range, double budget) {
+    const auto position = curvePositionErrorBound({{curve, range, range, false}});
+    const auto composition = surfaceCompositionErrorBound(surface, pcurve, range);
+    if (!position || !composition.bound)
+        throw std::domain_error("blendEdges: composizione della frontiera ISO non certificabile");
+    auto breaks = curve->breakpoints(range);
+    breaks.insert(breaks.end(), composition.breaks.begin(), composition.breaks.end());
+    fitCurveCertified([&](double t) {
+        const Vec2 uv = pcurve->point(t);
+        return 0.5 * curve->point(t) + 0.5 * surface->point(uv.x(), uv.y());
+    }, range, breaks, budget, [&](const Interval &span, const std::array<Vec3, 4> &poles) {
+        return outwardSum(position(span, poles), composition.bound(span, poles));
+    });
+}
+// Retain the original two poles and their original knot interval. Generated
+// exterior spans get their own anchors; no rounded global slope/intercept is
+// substituted for the original map. Providers later read these actual poles.
+CurvePtr<2> extendedIsoMap(const CurvePtr<2> &input, const Interval &window) {
+    const Curve<2> *basis = input.get();
+    while (basis && basis->type() == CurveType::Trimmed)
+        basis = static_cast<const TrimmedCurve<2> *>(basis)->basis().get();
+    if (!basis) throw std::domain_error("blendEdges: mappa ISO mancante");
+    if (basis->type() == CurveType::Line) {
+        const auto &line = static_cast<const Line<2> &>(*basis);
+        const Vec2 d = line.direction();
+        if ((d.x() == 0.0) == (d.y() == 0.0)) return {};
+        return std::make_shared<Line<2>>(line);
+    }
+    const auto *s = dynamic_cast<const BSplineCurve<2> *>(basis);
+    if (!s || s->degree() != 1 || s->poleCount() != 2 || !s->isClamped() || s->weight(0) != s->weight(1)) return {};
+    const auto &p = s->poles();
+    if ((p[0].x() == p[1].x()) == (p[0].y() == p[1].y())) return {};
+    const Interval anchor = s->domain();
+    std::vector<Vec2> poles;
+    std::vector<double> knots;
+    if (window.lo < anchor.lo) {
+        poles.push_back(s->point(window.lo));
+        knots = {window.lo, window.lo, anchor.lo};
+    } else knots = {anchor.lo, anchor.lo};
+    poles.push_back(p[0]); poles.push_back(p[1]);
+    if (window.hi > anchor.hi) {
+        knots.push_back(anchor.hi);
+        poles.push_back(s->point(window.hi));
+        knots.push_back(window.hi); knots.push_back(window.hi);
+    } else { knots.push_back(anchor.hi); knots.push_back(anchor.hi); }
+    return std::make_shared<BSplineCurve<2>>(1, knots, poles);
+}
+// Homogeneous degree elevation with ONE common scale per Bezier piece.
+// Unlike standardBezierPieces this never applies a Moebius parameter change.
+CurvePtr<3> concatenateBoundary(const std::vector<CurvePtr<3>> &curves,
+                               const std::vector<Interval> &ranges, std::size_t originalPiece) {
+    int degree = 3;
+    for (const auto &curve : curves) {
+        const auto *s = dynamic_cast<const BSplineCurve<3> *>(curve.get());
+        if (!s) throw std::domain_error("blendEdges: frontiera non B-spline");
+        degree = std::max(degree, s->degree());
+    }
+    std::vector<Vec3> poles;
+    std::vector<double> weights, knots;
+    double previousWeight = 1.0;
+    std::size_t visits = 0;
+    for (std::size_t k = 0; k < curves.size(); ++k) {
+        for (const auto &segment : rationalBezierPieces(*curves[k], ranges[k])) {
+            cancellationPoint();
+            if (++visits > 100000 || poles.size() + std::size_t(degree + 1) > 2000000)
+                throw std::domain_error("blendEdges: budget concatenazione frontiera esaurito");
+            std::vector<Vec3> hp;
+            std::vector<double> hw;
+            for (int i = 0; i <= segment.degree(); ++i) {
+                hw.push_back(segment.weight(i));
+                hp.push_back(segment.weight(i) * segment.poles()[std::size_t(i)]);
+            }
+            for (int p = segment.degree(); p < degree; ++p) {
+                std::vector<Vec3> np(std::size_t(p + 2));
+                std::vector<double> nw(std::size_t(p + 2));
+                for (int i = 0; i <= p + 1; ++i) {
+                    const double a = double(i) / double(p + 1);
+                    if (i) { np[std::size_t(i)] += a * hp[std::size_t(i - 1)]; nw[std::size_t(i)] += a * hw[std::size_t(i - 1)]; }
+                    if (i <= p) { np[std::size_t(i)] += (1.0 - a) * hp[std::size_t(i)]; nw[std::size_t(i)] += (1.0 - a) * hw[std::size_t(i)]; }
+                }
+                hp = std::move(np); hw = std::move(nw);
+            }
+            const double factor = poles.empty() ? 1.0 : previousWeight / hw.front();
+            if (!std::isfinite(factor) || !(factor > 0.0))
+                throw std::domain_error("blendEdges: pesi della frontiera non risolti");
+            if (poles.empty()) knots.assign(std::size_t(degree + 1), segment.domain().lo);
+            // Preserve the source endpoint at the head seam. The actual
+            // resulting exterior polynomial is then checked on both carriers.
+            if (!poles.empty() && k == originalPiece && ranges[k].lo == segment.domain().lo)
+                poles.back() = segment.poles().front();
+            for (int i = poles.empty() ? 0 : 1; i <= degree; ++i) {
+                poles.push_back(hp[std::size_t(i)] / hw[std::size_t(i)]);
+                weights.push_back(factor * hw[std::size_t(i)]);
+            }
+            previousWeight = weights.back();
+            knots.insert(knots.end(), std::size_t(degree), segment.domain().hi);
+        }
+    }
+    knots.push_back(ranges.back().hi);
+    return std::make_shared<BSplineCurve<3>>(degree, knots, poles, weights);
+}
