+std::shared_ptr<Data> prepare(const CurvePtr<3> &source, const Interval &range, const Frame3 &frame) {
+    cancellationPoint();
+    if (!source || !range.isFinite() || !(range.lo < range.hi) || !std::isfinite(range.length()))
