+        } else {
+            const auto &moved = static_cast<const TransformedCurve &>(*basis);
+            transforms.push_back(moved.transform());
+            basis = moved.basis().get();
+        }
+    }
+    const auto *helix = dynamic_cast<const HelixCurve *>(basis);
+    if (!helix)
+        return {};
