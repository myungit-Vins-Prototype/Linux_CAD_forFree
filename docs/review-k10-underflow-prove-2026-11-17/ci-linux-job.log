2026-11-17T17:00:10.5479567Z ##[group]Run # Il mirror Azure puo' restare in download fino al timeout del job.
2026-11-17T17:00:10.5480448Z # Il mirror Azure puo' restare in download fino al timeout del job.
2026-11-17T17:00:10.5481080Z # Cambia solo quel mirror sui runner effimeri; firme APT invariate.
2026-11-17T17:00:10.5481527Z sudo python3 - <<'PYAPT'
2026-11-17T17:00:10.5481910Z from pathlib import Path
2026-11-17T17:00:10.5482297Z directory = Path('/etc/apt/sources.list.d')
2026-11-17T17:00:10.5483004Z # Ubuntu usa anche mirror+file:/etc/apt/apt-mirrors.txt:
2026-11-17T17:00:10.5483554Z # cambiare solo .list/.sources lascia Azure attivo nei download.
2026-11-17T17:00:10.5484104Z paths = [Path('/etc/apt/sources.list'), Path('/etc/apt/apt-mirrors.txt'),
2026-11-17T17:00:10.5484850Z          Path('/etc/apt/apt-security-mirrors.txt'), *directory.glob('*.list'), *directory.glob('*.sources')]
2026-11-17T17:00:10.5485492Z for path in paths:
2026-11-17T17:00:10.5485917Z     if not path.is_file():
2026-11-17T17:00:10.5486274Z         continue
2026-11-17T17:00:10.5486614Z     original = path.read_text()
2026-11-17T17:00:10.5486988Z     updated = original
2026-11-17T17:00:10.5487352Z     for protocol in ('http', 'https'):
2026-11-17T17:00:10.5487889Z         updated = updated.replace(protocol + '://azure.archive.ubuntu.com/ubuntu',
2026-11-17T17:00:10.5488481Z                                   'https://archive.ubuntu.com/ubuntu')
2026-11-17T17:00:10.5488939Z     if updated != original:
2026-11-17T17:00:10.5489312Z         path.write_text(updated)
2026-11-17T17:00:10.5489711Z         print('Mirror Ubuntu principale:', path)
2026-11-17T17:00:10.5490127Z PYAPT
2026-11-17T17:00:10.5490625Z forgecad_apt_options=(-o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30)
2026-11-17T17:00:10.5491306Z sudo apt-get "${forgecad_apt_options[@]}" update 2>&1 | tee "$RUNNER_TEMP/dependencies.log"
2026-11-17T17:00:10.5492162Z sudo apt-get "${forgecad_apt_options[@]}" install --no-install-recommends -y \
2026-11-17T17:00:10.5492930Z   build-essential cmake ninja-build qt6-base-dev libqt6opengl6-dev \
2026-11-17T17:00:10.5493452Z   libgl1-mesa-dev zlib1g-dev libzstd-dev \
2026-11-17T17:00:10.5493905Z   libocct-foundation-dev libocct-modeling-data-dev \
2026-11-17T17:00:10.5494733Z   libocct-modeling-algorithms-dev libocct-data-exchange-dev \
2026-11-17T17:00:10.5495276Z   libocct-visualization-dev \
2026-11-17T17:00:10.5495702Z   2>&1 | tee -a "$RUNNER_TEMP/dependencies.log"
2026-11-17T17:00:10.5534476Z shell: /usr/bin/bash --noprofile --norc -e -o pipefail {0}
