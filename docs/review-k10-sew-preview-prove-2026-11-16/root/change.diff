+            if(!fin.pcurve)throw std::domain_error("cucitura: SP-curve certificata assente");
+            groups[{int(face),fin.edge}][fin.pcurve.get()].push_back({fin.pcurveTolerance,fin.certifiedPlaneBudget});
+        }
