+            std::sort(found->second.begin(),found->second.end());std::sort(expectedBudgets.begin(),expectedBudgets.end());
+            if(found->second!=expectedBudgets)throw std::domain_error("cucitura: fin o budget certificati modificati");
+        }
+    }
