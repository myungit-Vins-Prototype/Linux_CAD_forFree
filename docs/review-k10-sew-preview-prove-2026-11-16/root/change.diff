+  auto far = std::make_shared<Line<3>>(Vec3(0, 0, 2e-7), Vec3(1, 0, 0));
+  deviation = 123;
+  bool rejected = false;
+  try {
+    detail::fitPCurveOnPlane(far, plane, {-2, 5}, 1e-8, 1e-7, &deviation);
