    {
      "id": "kernel/fk_blend_model.h",
      "description": "Modello modificabile delle liste Body::build per raccordi ed estensioni; build espone la mappa esplicita degli edge compattati per le verifiche finali dei giunti, senza associazioni per prossimita.",
      "group": "kernel"
    },
    {
      "id": "kernel/fk_pcurve.cpp",
      "description": "SP-curve (Parasolid) / pcurve (OCCT): la curva di un edge nello spazio dei parametri (u, v) di una faccia, con lo stesso parametro dell'edge: S(p(t)) = C(t) per t nel range dell'edge.",
      "group": "kernel"
    },
    {
      "id": "kernel/fk_sheet.cpp",
      "description": "Taglio, rifilo ed estensione di lamine; offset NURBS planari certificati. Famiglia ISO scelta dalle pcurve sorgenti originali con limite fisico continuo e ancore per incidenza; giunti ISO verificati sui due supporti a cap fisso e fin ricontrollate dopo build/unify. Newton resta una costruzione campionata; fin nonISO native bicubiche sono verificate continuamente con budget prefit dopo build/unify tramite mappa edge esplicita, con fallimenti riconosciuti terminali e famiglie unsupported legacy.",
      "group": "kernel"
    },
    {
      "id": "kernel/fk_sheet_join_validation.cpp",
      "description": "Certifica le fin Newton effettivamente emesse usando indici modello e mappa edge, fissa il cap prefit sulle fin verificate e ricontrolla gli univoci discendenti dopo unify, anche senza history utente. Unsupported conserva la via legacy; fallimento riconosciuto terminale.",
      "group": "kernel"
    },
    {
      "id": "kernel/fk_surface_curve_bounds.cpp",
      "description": "Verifica continua del residuo E(t)-S(Q(t)) per cubiche e SP-curve lineari/cubiche non razionali su carrier bicubico nativo. Coefficienti originali, intervalli outward, partizione comune, tutte le celle nodali intersecate, budget e cancellazione.",
      "group": "kernel"
    },
    {
      "id": "kernel/fk_unify.cpp",
      "description": "Unisce facce sullo stesso dominio e bordi compatibili, preservando le cuciture UV necessarie alle superfici chiuse non periodiche.",
      "group": "kernel"
    }
  ],
