+FK_TEST(OffsetValidationCancellationAndReset) {
+    auto token = std::make_shared<std::atomic<bool>>(true);
+    CancellationScope scope(token);
+    int calls = 0;
+    double deviation = 123.;
+    bool cancelled = false;
+    try {
+        fitCurve(
+            [&](double t) {
+                ++calls;
+                return Vec3(t, 0, 0);
+            },
+            {0, 1}, {}, 1e-7, &deviation);
+    } catch (const OperationCancelled &) {
+        cancelled = true;
+    }
+    FK_CHECK(cancelled);
+    FK_CHECK(calls == 0);
+    FK_CHECK(deviation == 123.);
+    token->store(false);
+    cancelled = false;
+    try {
+        fitCurve(
+            [&](double t) {
+                ++calls;
+                if (t == .75)
+                    token->store(true);
+                return Vec3(t, 0, 0);
+            },
+            {0, 1}, {}, 1e-7, &deviation);
+    } catch (const OperationCancelled &) {
+        cancelled = true;
+    }
+    FK_CHECK(cancelled);
+    FK_CHECK(deviation == 123.);
+    token->store(false);
+    calls = 0;
+    cancelled = false;
+    try {
+        fitCurve(
+            [&](double t) {
+                if (++calls == 20)
+                    token->store(true);
+                return Vec3(t, std::sin(100 * t), 0);
+            },
+            {0, 1}, {}, 1e-7, &deviation);
+    } catch (const OperationCancelled &) {
+        cancelled = true;
+    }
+    FK_CHECK(cancelled);
+    FK_CHECK(calls == 20);
+    FK_CHECK(deviation == 123.);
+    token->store(false);
+    FK_CHECK(fitCurve([](double t) { return Vec3(t, 0, 0); }, {0, 1}, {}, 1e-7, &deviation) != nullptr);
+    FK_CHECK(deviation < 1e-7);
+}
