+// Il provider lavora sui coefficienti originali e sul parametro sorgente.
+// Le altre famiglie restano sul percorso storico; dati NURBS riconosciuti
+// ma non risolvibili devono invece propagare il rifiuto del certificatore.
+Kernel::CurveFitErrorBound freeOffsetErrorBound(const OffsetPiece &piece, const Kernel::Interval &range) {
+    const Kernel::Curve<2> *basis=piece.sourceCurve.get();
+    while(basis && basis->type()==Kernel::CurveType::Trimmed) {
+        Kernel::cancellationPoint();
+        basis=static_cast<const Kernel::TrimmedCurve<2> *>(basis)->basis().get();
+    }
+    if(!basis || basis->type()!=Kernel::CurveType::BSpline) return {};
+    // T x Z punta a destra, mentre signedDistance e' positiva a sinistra.
+    return Kernel::detail::extrusionOffsetErrorBound(Kernel::embedCurve(piece.sourceCurve,Kernel::Frame3()),
+                                                     range,-piece.signedDistance,Vec3(0,0,1));
+}
