+Kernel::CurveFitErrorBound freeOffsetErrorBound(const OffsetPiece &piece, const Kernel::Interval &range) {
+    const Kernel::Curve<2> *basis=piece.sourceCurve.get();
+    while(basis && basis->type()==Kernel::CurveType::Trimmed) {
+        Kernel::cancellationPoint();
+        basis=static_cast<const Kernel::TrimmedCurve<2> *>(basis)->basis().get();
