+        edges.push_back({pair.first, pair.second, std::make_shared<Line<3>>(a, b - a), {0, length}, 0});
+        maps.push_back(mitreUV({a.x(), a.y()}, {b.x(), b.y()}, {0, length}));
+    }
+    Body::BuildFace a, b;
+    a.surface = s;
+    b.surface = t;
