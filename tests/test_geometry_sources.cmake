cmake_minimum_required(VERSION 3.16)
include("${SOURCE_ROOT}/cmake/geometry_sources.cmake")
set(fixture "${TEST_ROOT}/geometry-sources-fixture")
file(MAKE_DIRECTORY "${fixture}/kernel")
file(WRITE "${fixture}/build.cpp" "#include \"shape.h\"\n")
file(WRITE "${fixture}/shape.h" "#include \"kernel/math.h\"\n")
file(WRITE "${fixture}/shape.cpp" "int shape() { return 1; }\n")
file(WRITE "${fixture}/kernel/math.h" "constexpr int precision = 1;\n")
file(WRITE "${fixture}/icons.cpp" "int icon = 1;\n")
function(fingerprint output)
    forgecad_collect_geometry_sources(sources "${fixture}" build.cpp)
    list(LENGTH sources count)
    if(NOT count EQUAL 4)
        message(FATAL_ERROR "Chiusura include/implementazioni inattesa: ${sources}")
    endif()
    string(REPLACE ";" "\n" lines "${sources}")
    file(WRITE "${fixture}/sources.txt" "${lines}\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DOUT=${fixture}/hash.h"
        "-DLIST=${fixture}/sources.txt" -P "${SOURCE_ROOT}/cmake/source_hash.cmake"
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Generazione impronta fallita")
    endif()
    file(READ "${fixture}/hash.h" hash)
    set(${output} "${hash}" PARENT_SCOPE)
endfunction()
fingerprint(before)
file(APPEND "${fixture}/icons.cpp" "// Modifica puramente visuale\n")
fingerprint(visual)
if(NOT before STREQUAL visual)
    message(FATAL_ERROR "Una modifica fuori dal calcolo invalida l'impronta")
endif()
file(APPEND "${fixture}/kernel/math.h" "// Modifica alla precisione\n")
fingerprint(geometry)
if(before STREQUAL geometry)
    message(FATAL_ERROR "Una dipendenza geometrica non invalida l'impronta")
endif()
file(WRITE "${fixture}/extra.h" "constexpr int extra = 1;\n")
file(APPEND "${fixture}/shape.cpp" "#include <extra.h>\n")
forgecad_collect_geometry_sources(expanded "${fixture}" build.cpp)
if(NOT "${fixture}/extra.h" IN_LIST expanded)
    message(FATAL_ERROR "Nuovo include transitivo non rilevato")
endif()
# Controllo anche il manifesto reale della configurazione corrente.
file(STRINGS "${TEST_ROOT}/generated/geometry_sources.txt" actual)
foreach(required IN ITEMS cad_feature_build.cpp cad_forge.cpp cad_types.h cad_topology_ref.cpp
        cad_geometry_refs.h cad_document_io.cpp cad_cuda_tessellation.cpp kernel/fk_loft.cpp)
    if(NOT "${SOURCE_ROOT}/${required}" IN_LIST actual)
        message(FATAL_ERROR "Dipendenza reale assente: ${required}")
    endif()
endforeach()
foreach(excluded IN ITEMS cad_icons.cpp cad_drawing_editor.cpp cad_drawing_window.cpp)
    if("${SOURCE_ROOT}/${excluded}" IN_LIST actual)
        message(FATAL_ERROR "Modulo visuale indipendente incluso: ${excluded}")
    endif()
endforeach()
message(STATUS "Impronta: include transitivi e implementazioni coperti, UI indipendente esclusa")
